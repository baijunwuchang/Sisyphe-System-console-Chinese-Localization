{
  "manifest_version": 3,
  "name": "Maurice Text Extractor",
  "version": "1.0",
  "description": "提取 Maurice Simul 页面上的韩文与英文句子，用于汉化词库准备",
  "permissions": [ "activeTab", "scripting", "downloads" ],
  "host_permissions": [ "https://lell1203.github.io/maurice_simul/*" ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [ "https://lell1203.github.io/maurice_simul/*" ],
      "js": [ "content.js" ],
      "run_at": "document_end",
      "all_frames": true
    }
  ]
}