{
  "manifest_version": 3,
  "name": "Maurice 文本标注与汉化",
  "version": "3.0",
  "description": "标注、查找、翻译并替换页面 UI 文本；代码区域保持原样",
  "permissions": [ "activeTab", "scripting", "downloads", "storage" ],
  "host_permissions": [ "https://lell1203.github.io/*" ],
  "action": { "default_title": "Maurice 工具（F1）" },
  "content_scripts": [
    {
      "matches": [ "https://lell1203.github.io/*" ],
      "js": [ "content.js" ],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js" }
}